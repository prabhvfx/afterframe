    "tail": 1.6,
    "lines": [
      {
        "text": "This skyscraper almost fell on New York."
      },
      {
        "text": "And almost nobody knew.",
        "pauseBefore": 0.2
      },
      {
        "text": "Citicorp Center. Fifty-nine stories. Nine hundred and fifteen feet.",
        "pauseBefore": 0.3
      },
      {
        "text": "But look at the bottom.",
        "pauseBefore": 0.2
      },
      {
        "text": "It stands on four stilts, in the middle of each side.",
        "pauseBefore": 0.15
      },
      {
        "text": "A church held the corner, and its deal banned columns through the new church.",
        "pauseBefore": 0.2
      },
      {
        "text": "In 1978, a Princeton student, Diane Hartley, studied it for her thesis.",
        "say": "In nineteen-seventy-eight, a Princeton student, Diane Hartley, studied it for her thesis.",
        "pauseBefore": 0.3
      },
      {
        "text": "Her questions about wind hitting the corners reached the engineer's office.",
        "pauseBefore": 0.15
      },
      {
        "text": "So the engineer, William LeMessurier, checked the math.",
        "say": "So the engineer, William /ləmˈɛʒəɹiˌeɪ/, checked the math.",
        "pauseBefore": 0.2
      },
      {
        "text": "Corner winds pushed the load on key joints up a hundred and sixty percent.",
        "pauseBefore": 0.2
      },
      {
        "text": "Then he learned what was holding those joints together.",
        "pauseBefore": 0.35
      },
      {
        "text": "Part two is up.",
        "pauseBefore": 0.3
      }
    ]
  },

    "tail": 2.0,
    "lines": [
      {
        "text": "A gap that grows. Three knocks. An empty bed."
      },
      {
        "text": "Nadia followed the carpet to the end of the hallway.",
        "pauseBefore": 0.5
      },
      {
        "text": "Theo was there. Asleep on his feet. His cheek pressed to the wall.",
        "pauseBefore": 0.5
      },
      {
        "text": "And he was whispering to it.",
        "pauseBefore": 0.45
      },
      {
        "text": "Almost done. It only needs one more.",
        "speaker": "theo",
        "speed": 0.85,
        "gain": 0.75,
        "pauseBefore": 0.6
      },
      {
        "text": "Theo! Wake up!",
        "speaker": "nadia",
        "pauseBefore": 0.5
      },
      {
        "text": "Nadia didn't wait for morning. She got a sledgehammer.",
        "pauseBefore": 0.6
      },
      {
        "text": "Three hits.",
        "pauseBefore": 0.4
      },
      {
        "text": "And from inside, three hits back.",
        "pauseBefore": 1.4
      },
      {
        "text": "Then the wall gave way.",
        "pauseBefore": 1.4
      },
      {
        "text": "The room was empty. The chair was still warm.",
        "pauseBefore": 0.8
      },
      {
        "text": "On the desk, the floor plan. Updated.",
        "pauseBefore": 0.5
      },
      {
        "text": "Seven rooms now.",
        "pauseBefore": 0.45
      },
      {
        "text": "Six people drawn inside. In a house with two.",
        "pauseBefore": 0.45
      },
      {
        "text": "And one pencil line, still moving.",
        "pauseBefore": 0.5
      },
      {
        "text": "Toward Nadia's room.",
        "pauseBefore": 0.4
      },
      {
        "text": "The full story is on YouTube.",
        "pauseBefore": 1.0
      }
    ]
  },
